NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://vms_user:vms_secret@localhost:5432/vms_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
QR_SECRET=your_qr_signing_secret_change_in_production

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:5173

# Email (AWS SES) — all outbound mail (OTP, invites, approvals, etc.) is sent
# via SES, queued through pg-boss (on your existing Postgres/Supabase DB) so
# a slow or failing send never blocks a request. Ask in chat for the one-time
# AWS console setup: domain verification, DKIM, production access, IAM user,
# configuration set + SNS bounce/complaint destination.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM="VisitIQ <no-reply@auth.nantatech.com>"
SES_CONFIG_SET=otp-transactional

# The same AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION above are also
# used for two optional features when set: Rekognition face search
# (faceService.js) and Textract business-card OCR (ocrService.js). Both are
# gated behind an ENABLED flag and silently skipped if unset — only Rekognition
# and/or Textract IAM permissions need adding to the same IAM user/role to turn
# them on.

# Email queue (pg-boss) — reuses DATABASE_URL by default. If you see
# connection issues under load, set this to Supabase's *direct* connection
# string (Project Settings → Database → "URI", not the pooler) instead.
# PGBOSS_DATABASE_URL=

# QR Code Settings
QR_PREPLANNED_EXPIRY_HOURS=24
QR_IMPROMPTU_EXPIRY_HOURS=2

# SMS (Twilio) — OTP is sent to visitor phone as well as email
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SMS_DEFAULT_COUNTRY_CODE=+91

# Temi Robot
TEMI_SERIAL=00126040079
TEMI_API_KEY=temi_internal_api_key
